# SOTA full-edge staging profile. HTTP-only: TLS belongs at the deployment
# boundary (Render, GCP load balancer, etc.) and is never guessed here.
#
# This profile renders the API edge AND the three BFF server blocks into one
# conf.d file so a single host-allowlist map covers every upstream. Select it
# with NGINX_TOPOLOGY=full-edge (default is api-only, unchanged behavior).
#
# Hostnames are deployment-owned. Provide every value explicitly at runtime.
# Per-app route maps live in snippets/bff-*.conf (see docs/nginx/bff-routing.md).

upstream c1rcle_fastify {
    least_conn;
    include /etc/nginx/c1rcle-gen/upstream-fastify*.inc;
    server ${FASTIFY_UPSTREAM} max_fails=3 fail_timeout=10s${NGINX_UPSTREAM_OPTS};
    keepalive 32;
    keepalive_requests 1000;
    keepalive_time 1h;
    keepalive_timeout 60s;
}

upstream c1rcle_bff_guest {
    least_conn;
    include /etc/nginx/c1rcle-gen/upstream-bff-guest*.inc;
    server ${BFF_GUEST_UPSTREAM} max_fails=3 fail_timeout=10s${NGINX_UPSTREAM_OPTS};
    keepalive 32;
    keepalive_requests 1000;
    keepalive_time 1h;
    keepalive_timeout 60s;
}

upstream c1rcle_bff_partner {
    least_conn;
    include /etc/nginx/c1rcle-gen/upstream-bff-partner*.inc;
    server ${BFF_PARTNER_UPSTREAM} max_fails=3 fail_timeout=10s${NGINX_UPSTREAM_OPTS};
    keepalive 32;
    keepalive_requests 1000;
    keepalive_time 1h;
    keepalive_timeout 60s;
}

upstream c1rcle_bff_admin {
    least_conn;
    include /etc/nginx/c1rcle-gen/upstream-bff-admin*.inc;
    server ${BFF_ADMIN_UPSTREAM} max_fails=3 fail_timeout=10s${NGINX_UPSTREAM_OPTS};
    keepalive 32;
    keepalive_requests 1000;
    keepalive_time 1h;
    keepalive_timeout 60s;
}

map $scheme $c1rcle_forwarded_proto {
    # Deployment-owned: Render/GCP terminate HTTPS before this listener, so
    # the edge sets it to https without trusting a client-supplied
    # X-Forwarded-Proto header or inventing proxy CIDRs.
    default ${NGINX_FORWARDED_PROTO};
}

map $host $c1rcle_host_allowed {
    default 0;
    ${NGINX_API_SERVER_NAME} 1;
    ${NGINX_GUEST_SERVER_NAME} 1;
    ${NGINX_PARTNER_SERVER_NAME} 1;
    ${NGINX_ADMIN_SERVER_NAME} 1;
}

# IP-based gating (geo on $remote_addr) does not work on platforms whose
# edge/load-balancer terminates and reconnects to this container — $remote_addr
# then reflects the platform's internal hop for every request, real or
# attacker, making an IP allowlist a no-op (confirmed on Render). Gate on a
# shared secret header instead, which does not depend on network topology.
map $http_x_readiness_token $c1rcle_readiness_allowed {
    default 0;
    "${NGINX_READINESS_TOKEN}" 1;
}

# Catch-all: the LB probe /healthz answers for ANY Host header; everything
# else on an unknown Host is dropped (444).
server {
    listen ${NGINX_HTTP_PORT} default_server;
    server_name _;

    include /etc/nginx/snippets/c1rcle/edge-healthz.conf;
    location / { return 444; }
}

# ── API edge: browsers/mobile call the allow-listed /api/v2/* paths directly.
server {
    listen ${NGINX_HTTP_PORT};
    server_name ${NGINX_API_SERVER_NAME};

    if ($c1rcle_host_allowed = 0) { return 444; }

    client_max_body_size 1m;
    limit_conn c1rcle_edge_connections 100;
    limit_req_status 429;
    limit_conn_status 429;

    include /etc/nginx/snippets/c1rcle/security-headers.conf;
    include /etc/nginx/snippets/c1rcle/api-locations.conf;
}

# ── Guest portal BFF (Next.js).
server {
    listen ${NGINX_HTTP_PORT};
    server_name ${NGINX_GUEST_SERVER_NAME};

    if ($c1rcle_host_allowed = 0) { return 444; }

    client_max_body_size 1m;
    limit_conn c1rcle_edge_connections 100;
    limit_req_status 429;
    limit_conn_status 429;

    include /etc/nginx/snippets/c1rcle/security-headers-bff.conf;

    set $c1rcle_bff_upstream c1rcle_bff_guest;
    include /etc/nginx/snippets/c1rcle/bff-locations.conf;
    include /etc/nginx/snippets/c1rcle/bff-guest-locations.conf;
}

# ── Partner dashboard BFF (Next.js).
server {
    listen ${NGINX_HTTP_PORT};
    server_name ${NGINX_PARTNER_SERVER_NAME};

    if ($c1rcle_host_allowed = 0) { return 444; }

    client_max_body_size 1m;
    limit_conn c1rcle_edge_connections 100;
    limit_req_status 429;
    limit_conn_status 429;

    include /etc/nginx/snippets/c1rcle/security-headers-bff.conf;

    set $c1rcle_bff_upstream c1rcle_bff_partner;
    include /etc/nginx/snippets/c1rcle/bff-locations.conf;
    include /etc/nginx/snippets/c1rcle/bff-partner-locations.conf;
}

# ── Admin console BFF (Next.js).
server {
    listen ${NGINX_HTTP_PORT};
    server_name ${NGINX_ADMIN_SERVER_NAME};

    if ($c1rcle_host_allowed = 0) { return 444; }

    client_max_body_size 1m;
    limit_conn c1rcle_edge_connections 100;
    limit_req_status 429;
    limit_conn_status 429;

    include /etc/nginx/snippets/c1rcle/security-headers-bff.conf;

    set $c1rcle_bff_upstream c1rcle_bff_admin;
    include /etc/nginx/snippets/c1rcle/bff-locations.conf;
    include /etc/nginx/snippets/c1rcle/bff-admin-locations.conf;
}
