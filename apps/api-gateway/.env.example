# Copy to .env.development (gitignored) and fill in real values for local dev.
# This file documents every var apps/api-gateway/src/config/index.ts reads.
# apps/api-gateway/src/config is the ONLY place process.env is read (guardrail-enforced).

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Redis (locks/reservations/rate-limit later; validated but unused until those phases)
REDIS_URL=redis://localhost:6379

# Firestore (B12 persistence adapter). STORAGE_DRIVER=memory keeps pnpm test
# hermetic/offline; STORAGE_DRIVER=firestore is used for `pnpm dev`. V2 data
# lives in new v2_*-prefixed collections in this project — never the v1 ones.
STORAGE_DRIVER=memory
FIRESTORE_PROJECT_ID=c1rcle-staging
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Better Auth (B10). Generate a real 32+ char secret for anything beyond local dev.
BETTER_AUTH_SECRET=dev-only-change-me
BETTER_AUTH_URL=http://localhost:8080
