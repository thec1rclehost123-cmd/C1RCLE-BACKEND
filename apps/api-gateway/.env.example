# Copy to .env.development (gitignored) and fill in real values for local dev.
# This file documents every var apps/api-gateway/src/config/index.ts reads.
# apps/api-gateway/src/config is the ONLY place process.env is read (guardrail-enforced).

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Redis (locks/reservations/rate-limit later; validated but unused until those phases)
REDIS_URL=redis://localhost:6379

# Firestore (B12 persistence adapter). STORAGE_DRIVER=memory keeps pnpm test
# hermetic/offline; STORAGE_DRIVER=firestore is used for `pnpm dev` and any
# real deploy. V2 data lives in new v2_*-prefixed collections in this project
# — never the v1 ones. CLIENT_EMAIL + PRIVATE_KEY are hard-required when
# STORAGE_DRIVER=firestore (config throws at boot otherwise).
STORAGE_DRIVER=memory
FIRESTORE_PROJECT_ID=c1rcle-staging
FIREBASE_CLIENT_EMAIL=
# PEM string; may contain literal \n — infrastructure/firestore/client.ts un-escapes it.
FIREBASE_PRIVATE_KEY=

# KYC document upload (signed PUT URLs, commit 2a9a4b3). Optional; onboarding
# doc upload 500s without it. Convention: <project>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# Razorpay (Phase 4 checkout/webhook). Optional until Phase 4 routes land.
# WEBHOOK_SECRET is validated at cold start once the webhook route exists.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Better Auth (B10). Generate a real 32+ char secret for anything beyond local dev.
BETTER_AUTH_SECRET=dev-only-change-me
# Magic-ticket signing secret (door/scanner door-sale flow). Production REQUIRES
# >= 32 characters (config throws at boot otherwise). 64 hex chars is a good size.
MAGIC_TICKET_SECRET=replace-with-strong-random-64-hex
# For a deploy, set this to the gateway's public URL (e.g. the Cloud Run *.run.app).
BETTER_AUTH_URL=http://localhost:8080

# Email OTP (signup verification). Send-only Resend API key: without one the OTP
# route 500s in production (throws 'Email provider not configured'); in dev it
# only logs the code as dev_email_otp and never emails.
RESEND_API_KEY=
# HMAC key for hashing email-OTP codes at rest. Hard-required in production.
EMAIL_OTP_SECRET=
