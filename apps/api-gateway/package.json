{
  "name": "api-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "seed:admin": "tsx --env-file-if-exists=.env.local src/scripts/seed-platform-admin.ts"
  },
  "dependencies": {
    "@c1rcle/contracts": "workspace:^",
    "@c1rcle/core": "workspace:^",
    "@fastify/cors": "^11.0.0",
    "better-auth": "^1.7.2",
    "better-auth-firestore": "^1.3.1",
    "fastify": "^5.12.1",
    "fastify-plugin": "^5.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
