{
  "name": "api-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:scenarios": "vitest run --config vitest.scenarios.config.mjs",
    "repair:fulfilment": "tsx --env-file-if-exists=.env.local src/scripts/repair-fulfilment.ts",
    "seed:admin": "tsx --env-file-if-exists=.env.local src/scripts/seed-platform-admin.ts",
    "backfill:analytics": "tsx --env-file-if-exists=.env.local src/scripts/backfill-analytics.ts",
    "configure:storage-cors": "tsx --env-file-if-exists=.env.local src/scripts/configure-storage-cors.ts",
    "pass6:email-previews": "tsx src/scripts/pass6-email-previews.ts",
    "pass6:auth-email-previews": "tsx src/scripts/pass6-auth-email-previews.ts",
    "pass6:email-dry-run": "tsx --env-file-if-exists=.env.local src/scripts/pass6-email-previews.ts --dry-run",
    "pass6:email-send-acceptance": "tsx --env-file-if-exists=.env.local src/scripts/pass6-email-previews.ts --send-acceptance",
    "pass6:email-dry-run-v2": "tsx --env-file-if-exists=.env.local src/scripts/pass6-email-previews.ts --dry-run-v2",
    "pass6:email-send-v2-acceptance": "tsx --env-file-if-exists=.env.local src/scripts/pass6-email-previews.ts --send-v2-acceptance"
  },
  "dependencies": {
    "@c1rcle/contracts": "workspace:^",
    "@c1rcle/core": "workspace:^",
    "@fastify/cors": "^11.0.0",
    "better-auth": "^1.7.7",
    "better-auth-firestore": "^1.3.3",
    "fastify": "^5.12.1",
    "fastify-plugin": "^5.0.0",
    "firebase-admin": "^13.0.0",
    "html-entities": "2.6.0",
    "ioredis": "^6.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^24.0.0",
    "ioredis-mock": "^8.13.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
