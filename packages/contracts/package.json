{
  "name": "@c1rcle/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./guest-onboarding": {
      "types": "./src/contracts/guest-onboarding.ts",
      "import": "./src/contracts/guest-onboarding.ts",
      "default": "./dist/contracts/guest-onboarding.js"
    },
    "./guest-social": {
      "types": "./src/contracts/guest-social.ts",
      "import": "./src/contracts/guest-social.ts",
      "default": "./dist/contracts/guest-social.js"
    },
    "./saved-events": {
      "types": "./src/contracts/saved-events.ts",
      "import": "./src/contracts/saved-events.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "^4.6.6"
  }
}
